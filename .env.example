# Copie este arquivo para .env e preencha SÓ o que for usar:
#   cp .env.example .env
# O .env nunca vai para o GitHub (está no .gitignore). Nunca cole chaves aqui neste arquivo.

# ---------- Groq (obrigatório: roteiro, prompts de imagem, metadados) ----------
GROQ_API_KEY=
# Deixe vazio para o programa escolher sozinho o melhor modelo da sua conta.
# Rode `python listar_modelos.py` para ver os nomes disponíveis.
GROQ_MODEL=
GROQ_STORY_MODEL=

# ---------- Imagens (ordem de uso; quando um acaba, passa para o próximo) ----------
# Opções: cloudflare, together, pollinations, ovh
IMAGE_PROVIDER=cloudflare
IMAGE_PROVIDERS=cloudflare,pollinations,ovh
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
POLLINATIONS_API_KEY=
TOGETHER_API_KEY=
# OVH funciona sem chave (2 imagens por minuto). A chave é opcional.
OVH_API_KEY=
# IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# POLLINATIONS_MODELS=flux,nanobanana
# IMAGE_DELAY_SECONDS=1

# ---------- Narração ----------
# Opções: kokoro_onnx (leve, padrão), kokoro, elevenlabs, openai
NARRATION_PROVIDER=kokoro_onnx
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=

# ---------- Vídeo ----------
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24
MUSIC_VOLUME=0.10
# Cortes renderizados em paralelo (com 4 GB de RAM, deixe 1 ou 2)
RENDER_WORKERS=2
VIDEO_CRF=20
VIDEO_PRESET=veryfast
SHOT_MIN_SECONDS=3.4
SHOT_MAX_SECONDS=4.6
SHAKE_CHANCE=0
SCANLINES=1

# ---------- Roteiro ----------
SCENE_WORDS=16
WORDS_PER_MINUTE=150
STORY_PAUSE_SECONDS=8
GROQ_BATCH_PAUSE_SECONDS=30

# ---------- Pasta de saída ----------
OUTPUT_DIR=output
